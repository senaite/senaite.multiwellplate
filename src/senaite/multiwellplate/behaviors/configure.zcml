<configure
        xmlns="http://namespaces.zope.org/zope"
        xmlns:plone="http://namespaces.plone.org/plone"
        i18n_domain="senaite.multiwellplate">

    <include package="plone.behavior" file="meta.zcml"/>

    <plone:behavior
        title="MultiWell Plate schema extender"
        description="Adds the ability plateable"
        name="senaite.multiwellplate.behavior"
        provides=".IMultiWellPlateBehavior"
        marker=".IPlateable"
        factory=".MultiWellPlateFactory"
        for="senaite.core.interfaces.IWorksheet"
    />

</configure>
