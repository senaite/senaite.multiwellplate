<configure
        xmlns="http://namespaces.zope.org/zope"
        xmlns:five="http://namespaces.zope.org/five"
        xmlns:i18n="http://namespaces.zope.org/i18n"
        xmlns:plone="http://namespaces.plone.org/plone"
        xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
        i18n_domain="senaite.multiwellplate">

    <five:registerPackage package="." initialize=".initialize"/>

    <!-- Register locales -->
    <i18n:registerTranslations directory="locales"/>

    <include package=".adapters"/>
    <include package=".behaviors"/>
    <include package=".browser"/>
    <include package=".content"/>
    <include package=".vocabularies"/>


    <!-- Generic Setup Handler -->
    <genericsetup:importStep
        name="senaite.multiwellplate.setup_handler"
        title="SENAITE MULTIWELL PLATE: Setup Handler"
        description="Run various configuration actions"
        handler=".setuphandlers.install">
        <depends name="typeinfo"/>
    </genericsetup:importStep>

    <!-- Generic Setup *INSTALL* Profile -->
    <genericsetup:registerProfile
        name="default"
        title="SENAITE MULTIWELL PLATE"
        directory="profiles/default"
        description="MultiWell Plate for SENAITE"
        pre_handler=".setuphandlers.pre_install"
        post_handler=".setuphandlers.post_install"
        provides="Products.GenericSetup.interfaces.EXTENSION"
    />

    <!-- Generic Setup *UNINSTALL* Profile -->
    <genericsetup:registerProfile
        name="uninstall"
        title="SENAITE MULTIWELL PLATE (uninstall)"
        directory="profiles/uninstall"
        description="MultiWell Plate for SENAITE"
        post_handler=".setuphandlers.post_uninstall"
        provides="Products.GenericSetup.interfaces.EXTENSION"
    />

    <!-- Configure printed templates for Worksheets  -->
    <plone:static
        directory="worksheets"
        type="worksheets"
        name="MWP print templates"
    />

</configure>
